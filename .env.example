# Copy to .env and set both model values before starting Compose.
# Quote paths with spaces. MODEL_FILE is relative to MODEL_DIR.
MODEL_DIR="/absolute/path/to/models"
MODEL_FILE="model.gguf"

HOST_BIND=127.0.0.1
HOST_PORT=8080
GPU_LAYERS=99
# Use tensor for multiple P100s to enable the patched internal AllReduce.
SPLIT_MODE=layer

CUDA_ARCH=60
JOBS=4
