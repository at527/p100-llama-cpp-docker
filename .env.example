# Copy to .env and set both model values before starting Compose.
# Quote paths with spaces. MODEL_FILE is relative to MODEL_DIR.
# Mount the entire cache so snapshot symlinks can resolve to their blobs.
MODEL_DIR="${HOME}/.cache/huggingface"
MODEL_FILE="hub/models--bartowski--google_gemma-4-31B-it-GGUF/snapshots/619aca7589c72be65dd968de8602ad23d68b5c14/google_gemma-4-31B-it-Q5_K_L.gguf"

HOST_BIND=127.0.0.1
HOST_PORT=8080
GPU_LAYERS=99
# Use tensor for multiple P100s to enable the patched internal AllReduce.
SPLIT_MODE=layer
# Context window size in tokens.
CTX_SIZE=2048

CUDA_ARCH=60
JOBS=4
